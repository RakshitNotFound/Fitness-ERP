# ----------------------------------------------------------------------------
# Fitness ERP — environment variables
# Copy this file to `.env.local` and fill in the values.
# NEVER commit `.env.local` (it is git-ignored).
# ----------------------------------------------------------------------------

# Supabase project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key — safe to expose to the browser (RLS enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — SERVER ONLY. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Email address that receives admin-level access
ADMIN_EMAIL=

# GPay / UPI number shown to members for payments
NEXT_PUBLIC_GPAY_NUMBER=
